            "description": "Absolute or repo-relative path to the source file.",
            "type": "string"
          },
          "snippet": {
            "minLength": 1,
            "maxLength": 65536,
            "description": "Replacement code body. May include `// ... existing code ...` (or `# ...` for Python) to preserve unchanged regions. NOT a diff or oldText/newText pair — just the new body.",
            "type": "string"
          },
          "after": {
            "minLength": 1,
            "maxLength": 512,
            "description": "Name of the function/class/method/variable to insert AFTER. Must be the SYMBOL NAME only (e.g. \"handleRequest\"), never source code or text.",
            "type": "string"
          },
          "replace": {
            "minLength": 1,
            "maxLength": 512,
            "description": "Name of the function/class/method/variable whose body to replace. Must be the SYMBOL NAME only (e.g. \"handleRequest\"), never source code or text.",
            "type": "string"
          }
        }
