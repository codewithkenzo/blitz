{
  "name": "@codewithkenzo/blitz",
  "version": "0.4.0",
  "description": "Fast Zig edit CLI for coding agents. Tree-sitter powered, token-efficient, MCP-ready.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "bin": {
    "blitz": "bin/blitz.js",
    "blitz-mcp": "mcp/blitz-mcp.js"
  },
  "files": [
    "bin/blitz.js",
    "mcp/blitz-mcp.ts",
    "mcp/blitz-mcp.js",
    "scripts/mcp-smoke.ts",
    "scripts/resolve-platform-bin.js",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    ".pi/docs/product/blitz.md"
  ],
  "optionalDependencies": {
    "@codewithkenzo/blitz-linux-x64-musl": "0.4.0",
    "@codewithkenzo/blitz-linux-arm64-musl": "0.4.0",
    "@codewithkenzo/blitz-darwin-arm64": "0.4.0",
    "@codewithkenzo/blitz-darwin-x64": "0.4.0",
    "@codewithkenzo/blitz-windows-x64": "0.4.0"
  },
  "scripts": {
    "bench": "bun .pi/bench/run.ts",
    "bench:llm": "bun .pi/bench/llm-tokens.ts",
    "bench:pi-local": "bun .pi/bench/pi-matrix.ts",
    "bench:large": "bun .pi/bench/deep-large-symbol.ts",
    "bench:small-target": "bun .pi/bench/deep-small-target.ts",
    "smoke:mcp": "bun scripts/mcp-smoke.ts",
    "pack:check": "npm pack --dry-run --json",
    "pack:verify": "node scripts/verify-package-isolation.js",
    "pack:linux-x64-musl": "npm pack ./packages/blitz-linux-x64-musl --json"
  },
  "keywords": [
    "ast",
    "tree-sitter",
    "code-edit",
    "mcp",
    "pi-agent"
  ],
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tiktoken": "^1.0.22"
  }
}
